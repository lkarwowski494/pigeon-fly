{
  "name": "pigeon-fly",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "PIGEON-FLY (Cyfrowy notes mistrza) — Offline-first asystent hodowli i lotów gołębi pocztowych z synchronizacją Supabase",
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify": "npm run typecheck && npm run check:i18n && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/qrcode": "^1.5.6",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-av": "^16.0.8",
    "expo-camera": "^57.0.6",
    "expo-clipboard": "^58.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-print": "^57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~57.0.0",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.5.4"
  }
}
